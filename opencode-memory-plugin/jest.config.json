{
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/tests/global-setup.js",
  "collectCoverageFrom": ["lib/**/*.js", "!lib/**/*.test.js", "!node_modules/**"],
  "coverageDirectory": "coverage",
  "coverageThreshold": {
    "global": {
      "branches": 10,
      "functions": 10,
      "lines": 10,
      "statements": 10
    }
  },
  "verbose": true,
  "projects": ["<rootDir>/jest.unit.config.cjs", "<rootDir>/jest.integration.config.cjs"]
}
