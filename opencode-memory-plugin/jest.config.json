{
  "testEnvironment": "node",
  "coverageDirectory": "coverage",
  "collectCoverageFrom": ["lib/**/*.js", "!lib/**/*.test.js", "!node_modules/**"],
  "testMatch": ["**/tests/**/*.test.js"],
  "coverageThreshold": {
    "global": {
      "branches": 80,
      "functions": 80,
      "lines": 80,
      "statements": 80
    }
  },
  "verbose": true,
  "testTimeout": 10000
}
