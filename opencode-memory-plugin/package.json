{
  "name": "@csuwl/opencode-memory-plugin",
  "version": "3.2.0-beta.1",
  "description": "OpenClaw-style memory system with L0/L1/L2 layered storage, ULID naming, and automatic sync",
  "license": "MIT",
  "type": "module",
  "main": "plugin.js",
  "exports": {
    ".": {
      "import": "./plugin.js"
    }
  },
  "bin": {
    "opencode-memory-plugin": "bin/install.cjs",
    "opencode-memory": "cli/index.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csuwl/opencode-memory-plugin.git"
  },
  "keywords": [
    "opencode",
    "memory",
    "ai",
    "openclaw",
    "memory-plugin",
    "surrealdb",
    "vector-search",
    "timeline",
    "sync",
    "conflict-resolution"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "^1.0.0",
    "chokidar": "^5.0.0",
    "dotenv": "^16.4.5",
    "fast-json-patch": "^3.1.1",
    "oxc-parser": "^0.121.0",
    "pino": "^9.5.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "jest": "^29.7.0",
    "markdownlint-cli2": "^0.22.0",
    "oxlint": "1.57.0",
    "pino-pretty": "^13.0.0",
    "prettier": "3.8.1",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "^5.7.3",
    "web-tree-sitter": "^0.26.7"
  },
  "files": [
    "memory/",
    "lib/",
    "cli/",
    "tools/",
    "agents/",
    "scripts/",
    "bin/",
    "plugin.js",
    "index.js",
    "README.npm.md"
  ],
  "scripts": {
    "install": "node bin/install.cjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\"",
    "format": "prettier --write \"**/*.{js,mjs,cjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,json,md}\"",
    "rtm:update": "node ../scripts/update-rtm.js --all",
    "rtm:check": "node ../scripts/update-rtm.js --check",
    "design:verify": "node ../scripts/check-design-compliance.js --all",
    "design:suggest": "node ../scripts/opencode-integration.js suggest-commit",
    "weekly-check": "node ../scripts/update-rtm.js --check && node ../scripts/check-design-compliance.js --all"
  }
}
